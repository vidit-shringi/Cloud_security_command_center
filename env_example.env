# ==========================================
# INTERNSHIELD SECURE ENVIRONMENT VARIABLES
# ==========================================
# WARNING: DO NOT COMMIT ACTUAL SECRETS TO GITHUB!
# Rename this file to '.env' and fill in your actual keys.

# AI Provider API Keys (Uncomment and fill the one you want to use)
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="AIza..."

# AWS Configuration Override
# Note: It's heavily recommended to use 'aws configure' in terminal instead of hardcoding here.
# AWS_ACCESS_KEY_ID="your_access_key"
# AWS_SECRET_ACCESS_KEY="your_secret_key"
# AWS_DEFAULT_REGION="us-east-1"